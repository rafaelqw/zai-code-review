{
  "name": "zai-code-review",
  "version": "0.4.0",
  "description": "AI-powered code review GitHub Action using Z.ai",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "build:pr-description": "ncc build src/pr-description.js -o dist-pr-description --license dist-pr-description/licenses.txt",
    "build:all": "npm run build && npm run build:pr-description"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1"
  }
}
